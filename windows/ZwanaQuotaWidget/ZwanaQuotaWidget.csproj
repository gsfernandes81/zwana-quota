<Project Sdk="Microsoft.NET.Sdk">

  <!-- The widget provider is a packaged Win32 COM server: the widgets board
       activates it on demand, it hands back an Adaptive Card, and it exits
       again. There is no window, hence WinExe rather than a console app that
       would flash a terminal every time the board is opened.

       Packaging is NOT done here. The MSIX is packed by hand in CI with
       MakeAppx (see .github/workflows/windows-msix.yml), which keeps the
       build off any Visual Studio workload the runner image may or may not
       carry, and keeps what is packed to exactly what is published. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The COM interop and P/Invoke source generators emit unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ZwanaQuotaWidget</AssemblyName>
    <RootNamespace>ZwanaQuotaWidget</RootNamespace>
    <!-- MSIX-packaged, so the Windows App SDK bootstrapper is not wanted. -->
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <!-- The target machine is on a metered satellite link and cannot fetch a
         .NET runtime or a Windows App Runtime installer, so both ride inside
         the package. -->
    <SelfContained Condition="'$(SelfContained)' == ''">true</SelfContained>
    <WindowsAppSDKSelfContained Condition="'$(WindowsAppSDKSelfContained)' == ''">$(SelfContained)</WindowsAppSDKSelfContained>
    <!-- Every byte here crosses a metered satellite link; see windows/README.md
         for what was measured and what it bought. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- CsWinRT builds the WinRT vtables for managed classes that implement
         projected interfaces. Under Native AOT it must do so at compile time,
         and if it does not notice our provider, the object handed to the board
         answers QueryInterface(IWidgetProvider) with E_NOINTERFACE — which is
         where the AOT build currently stops. The warnings say what it noticed. -->
    <CsWinRTAotOptimizerEnabled>true</CsWinRTAotOptimizerEnabled>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Widgets COMPONENT package, not the Microsoft.WindowsAppSDK
         metapackage. The metapackage is the whole SDK: WinUI, the XAML
         renderer, and from 1.8 onwards onnxruntime.dll and DirectML.dll — 66 MB
         of runtime this provider never calls, because it renders an Adaptive
         Card and the board draws it. The component brings one 2.5 MB DLL and
         its projection, and Base (half a megabyte of MSBuild targets) brings
         the self-contained plumbing with it.

         That plumbing is load-bearing and invisible: the Widgets package
         carries a package.appxfragment declaring WidgetManager and friends as
         WinRT activatable classes, and Base's SelfContained.targets turns it
         into a side-by-side manifest embedded in the exe. Without it,
         WidgetManager.GetDefault() throws class-not-registered at runtime.
         The build verifies this rather than assuming it. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="2.0.5" />
  </ItemGroup>

</Project>
