# Credentials — the zwana portal login, read by zwana_quota.py
.env

__pycache__/
*.pyc

# uv-managed dev environment (make dev)
.venv/
.pytest_cache/

# mutation testing (make mutants)
.poodle-temp/
.hypothesis/

# Android build output (android/) -- CI builds the APK, see android/README.md
android/**/.gradle/
android/**/build/
android/.kotlin/
android/**/.kotlin/
android/local.properties
*.keystore
*.jks

# Signing keys, anywhere in the tree, so they can live in the checkout on the
# phone that makes them: the APK keystore (zwana.p12, android/README.md) and
# the Garmin developer key (developer_key.der/.pem). The repo is public; they
# reach CI only as secrets. The .b64 is what `base64 -w0 > file` leaves behind.
*.p12
*.pfx
*.der
*.pem
*.b64

# Connect IQ build output (garmin/); its developer key is covered above
garmin/bin/
