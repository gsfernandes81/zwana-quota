project.manifest = manifest.xml

# Whether a watch's number fonts hold the letters of ON and OFF, so the
# Connection page can draw them that large (QuotaView.wordFonts). The Solar's
# do; the AMOLEDs' draw a box for each letter. Seen in the simulator, whose
# fonts are the watches' own. A new product takes the text fonts until it is
# looked at.
base.excludeAnnotations = numberWords
instinct3solar45mm.excludeAnnotations = textWords

# The AMOLEDs' screens are over twice the Solar's 176 pixels: their device
# icons come at 2:1 (garmin/tools/glyphs.py), from a folder that overrides.
instinct3amoled45mm.resourcePath = $(instinct3amoled45mm.resourcePath);resources-2x
instinct3amoled50mm.resourcePath = $(instinct3amoled50mm.resourcePath);resources-2x
