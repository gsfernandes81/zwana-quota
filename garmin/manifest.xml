<?xml version="1.0"?>
<!-- The watch half of the zwana quota companion (see README.md).

     id is the app's identity to the phone: android/app/.../Garmin.kt carries
     the same string as APP_ID, and the two must match or the phone is sending
     to an app that does not exist.

     A watch-app with a glance, not a widget: on glance-loop watches such as
     the Instinct 3 that is the current shape of "something in the glances". -->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        id="8bc64f99960b479b9613957aee9bf73c"
        type="watch-app"
        name="@Strings.AppName"
        entry="QuotaApp"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.2.0">
        <iq:products>
            <iq:product id="instinct3amoled45mm"/>
            <iq:product id="instinct3amoled50mm"/>
            <iq:product id="instinct3solar45mm"/>
        </iq:products>
        <iq:permissions>
            <!-- Background: woken by the phone's message when not running.
                 Communications: to receive it at all. -->
            <iq:uses-permission id="Background"/>
            <iq:uses-permission id="Communications"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
