<?xml version="1.0" encoding="utf-8"?>
<!-- The portal icon's C, turned into a gauge: a ring open on the right, solid
     for what is left and faint for what has gone, with a level bar standing
     inside it where the I stood beside. 108dp canvas; the glyph is 48dp
     across, well inside the 66dp safe zone, so no launcher mask clips it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The track: what has been used. -->
    <path
        android:pathData="M35.21,60.84 A20,20 0 0,0 68.14,68.14"
        android:strokeWidth="8"
        android:strokeAlpha="0.4"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />
    <!-- The gauge: what is left. -->
    <path
        android:pathData="M68.14,39.86 A20,20 0 0,0 35.21,60.84"
        android:strokeWidth="8"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />
    <!-- The level bar. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M51,47 a3,3 0 0,1 6,0 v14 a3,3 0 0,1 -6,0 z" />
</vector>
