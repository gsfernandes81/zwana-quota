<?xml version="1.0" encoding="utf-8"?>
<!-- The face resized big enough for the device list (Android 12 and later
     choose it by size): the same lines as widget.xml, and under a rule a
     row per device, the last row saying how many more there are. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <include layout="@layout/widget_top" />

    <!-- The status and, where the row has room, how much of what is left is
         paid. The status is measured first, so a warning on it is never the
         part that gives way. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/status"
            style="@style/WidgetLine"
            android:layout_width="wrap_content"
            android:text="no reading" />

        <TextView
            android:id="@+id/paid"
            style="@style/WidgetLine"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:textColor="#A6ADC8"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/reset"
        style="@style/WidgetLine"
        android:ellipsize="start" />

    <FrameLayout
        android:id="@+id/rule"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="4dp"
        android:background="#1FCDD6F4" />

    <TextView
        android:id="@+id/device1"
        style="@style/WidgetDevice" />

    <TextView
        android:id="@+id/device2"
        style="@style/WidgetDevice" />

    <TextView
        android:id="@+id/device3"
        style="@style/WidgetDevice" />

    <TextView
        android:id="@+id/footnote"
        style="@style/WidgetLine"
        android:layout_marginTop="2dp"
        android:text="tap to read"
        android:textColor="#A6ADC8"
        android:textSize="12sp" />
</LinearLayout>
