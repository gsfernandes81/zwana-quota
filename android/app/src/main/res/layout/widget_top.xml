<?xml version="1.0" encoding="utf-8"?>
<!-- The figure, big, and beside it the data switch. The switch is its own
     tap target inside the widget's: tapping the figure reads the portal,
     tapping the switch switches. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/figure"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="44sp"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical|start"
        android:maxLines="1"
        android:text="quota ?"
        android:textColor="#BAC2DE" />

    <TextView
        android:id="@+id/pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/pill_on"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:minHeight="32dp"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="12dp"
        android:text="● Data on"
        android:textColor="#A6E3A1"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
