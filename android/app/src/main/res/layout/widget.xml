<?xml version="1.0" encoding="utf-8"?>
<!-- The face: the figure and the data switch, then four lines of small
     print. Each small line is a line of its own and never wraps. The reset
     line ends with the time and is ellipsized from its start, so a narrow
     widget loses the grant before it loses the time. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <include layout="@layout/widget_top" />

    <!-- The status and, where the row has room, how much of what is left is
         paid. The status is measured first, so a warning on it is never the
         part that gives way. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/status"
            style="@style/WidgetLine"
            android:layout_width="wrap_content"
            android:text="no reading" />

        <TextView
            android:id="@+id/paid"
            style="@style/WidgetLine"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:textColor="#A6ADC8"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/reset"
        style="@style/WidgetLine"
        android:ellipsize="start" />

    <TextView
        android:id="@+id/devices"
        style="@style/WidgetLine"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/footnote"
        style="@style/WidgetLine"
        android:text="tap to read"
        android:textColor="#A6ADC8"
        android:textSize="12sp" />
</LinearLayout>
