<?xml version="1.0" encoding="utf-8"?>
<!-- The face: the figure, big, and three lines of small print. Each small line
     is a line of its own and never wraps, so the reset -- which leads its
     line -- cannot be pushed off by anything else. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/figure"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="44sp"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical|start"
        android:maxLines="1"
        android:text="quota ?"
        android:textColor="#BAC2DE" />

    <TextView
        android:id="@+id/status"
        style="@style/WidgetLine"
        android:text="no reading" />

    <TextView
        android:id="@+id/reset"
        style="@style/WidgetLine" />

    <TextView
        android:id="@+id/footnote"
        style="@style/WidgetLine"
        android:text="tap to read"
        android:textColor="#A6ADC8"
        android:textSize="12sp" />
</LinearLayout>
